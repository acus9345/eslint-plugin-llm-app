{
  "name": "eslint-plugin-llm-app",
  "version": "0.1.0",
  "description": "ESLint rules for common LLM-app mistakes: calls with no token limit or timeout, retry loops that never stop, hardcoded API keys, unread streams and JSON.parse on raw model output.",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "llm",
    "ai",
    "openai",
    "anthropic",
    "claude",
    "gemini",
    "ai-sdk",
    "lint",
    "security"
  ],
  "homepage": "https://github.com/acus9345/eslint-plugin-llm-app#readme",
  "bugs": {
    "url": "https://github.com/acus9345/eslint-plugin-llm-app/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acus9345/eslint-plugin-llm-app.git"
  },
  "license": "MIT",
  "author": "acus9345 <acus9345@gmail.com>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "prelint": "npm run build",
    "lint": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test \"test/*.test.ts\"",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "eslint": ">=9"
  },
  "devDependencies": {
    "@types/estree": "^1.0.10",
    "@types/node": "^26.6.6",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.13.0",
    "typescript": "~6.0.3"
  }
}
